# ---------------------------------------------------------------------------
# MLA File Management System - environment configuration
# Copy this file to .env (repo root) and fill in real values.
# NEVER commit the real .env. Frontend must never receive secrets.
# ---------------------------------------------------------------------------

# ---- Runtime ----
NODE_ENV=development
# Server HTTP port
PORT=4000
# Public base URL of the API (used in OpenAPI, QR tokens, emails)
BACKEND_URL=http://localhost:4000
# Public base URL of the SPA (CORS origin, password-reset links)
FRONTEND_URL=http://localhost:5173

# ---- Database (MongoDB Atlas) ----
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/mla_fms?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/mla_fms?retryWrites=true&w=majority

# ---- Auth / JWT ----
# Use long random strings (openssl rand -hex 48). Keep them out of the client.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Cookie settings for the refresh token
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---- Serve the built SPA from the Node server (production single-origin) ----
# Dev leaves this false (Vite serves the client on :5173).
SERVE_CLIENT=false
CLIENT_DIR=../client/dist

# ---- File storage ----
# STORAGE_PROVIDER: local | s3
STORAGE_PROVIDER=local
# For local provider (path is relative to the server package):
LOCAL_STORAGE_DIR=./storage-data
# Max upload size in bytes (10 MB default)
MAX_FILE_SIZE=10485760
# Comma-separated allowed extensions (also enforced server-side by MIME sniff)
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,webp,doc,docx

# ---- AWS S3 / S3-compatible (only when STORAGE_PROVIDER=s3) ----
# For Cloudflare R2 / Backblaze B2 / MinIO: set AWS_S3_ENDPOINT + AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# Seconds a signed view/download URL stays valid
S3_SIGNED_URL_TTL=300

# ---- OCR (optional) ----
# OCR_PROVIDER: none | tesseract | textract
OCR_PROVIDER=none

# ---- Email (optional) ----
# EMAIL_PROVIDER: none | smtp
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false   # true for port 465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MLA Office <no-reply@example.gov.in>"

# ---- SMS (optional) ----
# SMS_PROVIDER: none | msg91 | twilio
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Defaults applied at first-run setup (editable later in Settings) ----
DEFAULT_SLA_DAYS=15
FILE_ID_FORMAT=MLA/{YYYY}/{SEQ:6}
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- Seed ----
# Credentials created by `npm run seed` (DEMO data). Change before any real use.
SEED_ADMIN_EMAIL=admin@mla.local
SEED_ADMIN_PASSWORD=Admin@12345
