# ===========================================================================
# MLA File Management System - PRODUCTION environment
# Copy to deploy/.env and fill in. NEVER commit deploy/.env.
# Generate secrets:  openssl rand -hex 48
# ===========================================================================

# ---- Runtime ----
NODE_ENV=production
PORT=4000
SERVE_CLIENT=true
# Public HTTPS URL of the app (used in OpenAPI, QR tokens, e-mail links)
BACKEND_URL=https://mlaoffice.example.in
FRONTEND_URL=https://mlaoffice.example.in

# ---- Caddy (reverse proxy / TLS) ----
DOMAIN=mlaoffice.example.in
ACME_EMAIL=it-admin@example.in

# ---- Database: MongoDB Atlas ----
# Atlas > Database > Connect > Drivers. Add the server's public IP to the
# Atlas IP Access List. URL-encode any special chars in the password.
DATABASE_URL=mongodb+srv://mla_app:<password>@cluster0.xxxxx.mongodb.net/mla_fms?retryWrites=true&w=majority&appName=mla-fms

# ---- Auth / JWT (MUST be long, random, and different from each other) ----
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_48
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_openssl_rand_hex_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Cookie is scoped to /api/auth; set the registrable domain.
COOKIE_DOMAIN=mlaoffice.example.in
COOKIE_SECURE=true

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10

# ---- File storage: S3-compatible (private bucket, block ALL public access) ----
STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mla-fms-documents-prod
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# Seconds a signed view/download link stays valid
S3_SIGNED_URL_TTL=300
# For Cloudflare R2 / Backblaze B2 / MinIO / Wasabi (leave blank for AWS S3):
# AWS_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_FORCE_PATH_STYLE=true

MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,webp,doc,docx

# ---- Optional integrations (leave as 'none' until configured) ----
OCR_PROVIDER=none
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false   # true for port 465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MLA Office <no-reply@example.in>"
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

# ---- App defaults (also editable later in Settings) ----
DEFAULT_SLA_DAYS=15
FILE_ID_FORMAT=MLA/{YYYY}/{SEQ:6}
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- Unused in production (first Super Admin is created by the setup wizard) ----
SEED_ADMIN_EMAIL=admin@example.in
SEED_ADMIN_PASSWORD=unused-in-production-change-me
